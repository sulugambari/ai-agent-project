# --- Model provider ---------------------------------------------------------
# Which provider the agent uses. This is the "one small application boundary"
# 05-evaluation-and-release.md asks for when comparing providers: prompts, tools,
# retrieval results, parameters and evaluation cases stay fixed, and only this
# changes. Groq is retained rather than replaced, because the point of the
# extension is a comparison, not a swap.
LLM_PROVIDER=groq
# groq | openrouter

# --- Groq (the core path, per AGENTS.md) ------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenRouter (optional extension: compare another provider) --------------
# OpenRouter is a GATEWAY, so 05 requires recording both the model selected here
# AND the provider actually serving it. Note two risks before choosing a model:
#   * not every model on OpenRouter supports TOOL CALLING, which this agent
#     requires - a model without it will fail every turn;
#   * free models are rate limited too, so the token-per-minute arithmetic that
#     broke the Groq runs (one turn is roughly 6,100 tokens) applies again.
# Paste the key below. Leave OPENROUTER_MODEL empty and it will be chosen after
# checking the live model list for tool-calling support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Sent as X-Title so usage is attributable in the OpenRouter dashboard.
OPENROUTER_APP_TITLE=Northstar Release Coordinator

# --- Live GitHub source (file 04) -------------------------------------------
GITHUB_REPOSITORY=sulugambari/ai-agent-project
GITHUB_TOKEN=
